#!/bin/bash
# schelk's CLI, as benchmarkoor drives it (pkg/datadir/schelk.go), on a plain directory: the
# pre-run advances it in place and nothing can roll it back. For a disposable builder whose disk
# cannot hold a copy (build/README.md); tools/zfs-schelk keeps a pristine @baseline instead.
#
#   SCHELK_DIR    the datadir (required); bind-mounted onto itself so it is in /proc/mounts
#   SCHELK_STATE  state file benchmarkoor reads (default /var/lib/schelk/state.json)
#
# restore/recover before a pre-run are no-ops on a pristine dir. Once 01-prerun.sh has marked it
# .advanced they fail: a rollback that cannot happen must not report success.
set -euo pipefail
DIR=${SCHELK_DIR:?SCHELK_DIR is not set}
STATE=${SCHELK_STATE:-/var/lib/schelk/state.json}
die() { echo "inplace-schelk: $*" >&2; exit 1; }

mkdir -p "$(dirname "$STATE")"
exec 9>"${STATE%.json}.lock"
# benchmarkoor retries on exactly this text while another schelk holds the lock.
flock -n 9 || die "Another schelk process is already running"
[ -d "$DIR" ] || die "no directory $DIR"
mountpoint -q "$DIR" || sudo mount --bind "$DIR" "$DIR"

case "${1:-}" in
  init|mount|promote) ;;
  restore|recover|full-recover)
    [ ! -e "$DIR/.advanced" ] || die "$DIR was advanced in place and has no baseline to $1 to" ;;
  *) die "unsupported verb '${1:-}' (init|restore|recover|full-recover|mount|promote)" ;;
esac
printf '{"mount_point":"%s","is_mounted":true,"backend":"inplace"}\n' "$DIR" > "$STATE"
